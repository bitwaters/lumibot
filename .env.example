GMGN_API_KEY=your_gmgn_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Control chats: receive pushes AND may run all bot commands including /reset_paper.
TELEGRAM_CHAT_IDS=123456789
# Groups/supergroups: receive pushes + may use /stats /positions /help etc.
# /reset_paper is blocked in groups. Add bot, send /chatid, paste the id here.
TELEGRAM_GROUP_CHAT_IDS=-1001234567890
LUMIBOT_CONFIG=config/chains.yaml
LUMIBOT_DB_PATH=data/lumibot.db
# Optional overrides:
# LUMIBOT_SKIP_IPV4_CHECK=0

GMGN_API_KEY=your_gmgn_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Control chats: receive pushes AND may run bot commands (usually your private chat).
TELEGRAM_CHAT_IDS=123456789
# Optional push-only groups/supergroups (negative ids). Cannot run /reset_paper.
# Add bot to the group, send /chatid, then paste the id here.
TELEGRAM_GROUP_CHAT_IDS=-1001234567890
LUMIBOT_CONFIG=config/chains.yaml
LUMIBOT_DB_PATH=data/lumibot.db
# Optional overrides:
# LUMIBOT_SKIP_IPV4_CHECK=0
